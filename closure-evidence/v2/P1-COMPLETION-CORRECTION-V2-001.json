 "f2_semantic_change": {
  "before": "§10: EXECUTED + INDETERMINATE -> 'PLAN or INTEGRATION, by reason'; implemented as CANDIDATE + INDETERMINATE(PRECONDITION_ABSENT) -> PRECONDITION_ABSENT, PLAN (routing keyed by site PARENT/CANDIDATE)",
  "after": {
   "PARENT + INTRODUCE + REQUIRES_SUBJECT + subject absent": "READY; no failure owner; expected pre-state",
   "PARENT + PRESERVE/VERIFY + required subject absent": "PRECONDITION_BROKEN; PLAN",
   "CANDIDATE + admitted obligation + required subject absent": "DEVELOPER",
   "POST_MERGE + subject verified at candidate now absent": "INTEGRATION",
   "observation harness cannot run (UNRUNNABLE)": "ENVIRONMENT"
  },
  "rfc_text": "§10 table (REFUTED and INDETERMINATE owner cells), new §10.3 with class MeasurementPoint and its table, freeze-table F2 row, adversarial cases OWNER-MP-1..4",
  "code": {
   "route": "route(result, spec, MeasurementPoint, role=None)",
   "removed_codes": [
    "PRECONDITION_ABSENT (-> PLAN at the candidate)"
   ],
   "added_codes": [
    "SUBJECT_ABSENT_AT_CANDIDATE (DEVELOPER)",
    "PRECONDITION_BROKEN (PLAN, parent)",
    "POST_MERGE_REGRESSION (INTEGRATION)",
    "POST_MERGE_SUBJECT_LOST (INTEGRATION)"
   ],
   "vocabulary": "MeasurementPoint {PARENT, CANDIDATE, POST_MERGE} added to F2 (aisef2/arch/enums.py, RFC §10.3)"
  }
 },
