 "work_package": "WP-1.4",
 "rfc_sections": [
  "22",
  "10"
 ],
 "taxonomy": {
  "PROBE_UNRUNNABLE": {
   "owner": "ENVIRONMENT",
   "retryable": true,
   "budget": "ENVIRONMENT",
   "rule": "§10: UNRUNNABLE -> ENVIRONMENT (the only row that may); environment retry policy (§15 TEST-1)"
  },
  "PROBE_INVALID_SPEC": {
   "owner": "INTEGRATION",
   "retryable": false,
   "budget": null,
   "rule": "§10: INVALID_SPEC -> PLAN / INTEGRATION. INTEGRATION: §12 checks 2, 6 and 9 establish contract->spec integrity and probe availability before plan freeze, so a spec that reaches a probe unevaluable is a harness integration fault; §14: PROBE_INVALID is a hard blocker"
  },
  "CONTRACT_UNSATISFIED": {
   "owner": "DEVELOPER",
   "retryable": true,
   "budget": "DEVELOPER",
   "rule": "§10: failure at the candidate -> DEVELOPER; §10.1: failure means ContractSatisfaction UNSATISFIED, never a raw verdict"
  },
  "PRECONDITION_ABSENT": {
   "owner": "PLAN",
   "retryable": false,
   "budget": null,
   "rule": "§10: INDETERMINATE -> PLAN or INTEGRATION, by reason. PLAN: §13 routes PRECONDITION_ABSENT to PRECONDITION_BROKEN, a hard plan blocker (§14); §10.2 forbids a vacuous verdict, so the missing subject is a plan fact, never a developer failure"
  },
  "MISSING_CREDENTIAL": {
   "owner": "ENVIRONMENT",
   "retryable": true,
   "budget": "ENVIRONMENT",
   "rule": "§22: distinct from INVALID_CREDENTIAL because the fix differs — provide the credential in the environment"
  },
  "INVALID_CREDENTIAL": {
   "owner": "PROVIDER",
   "retryable": false,
   "budget": null,
   "rule": "§22: MUST NOT be retryable (D-006: credential rejection charged to quality attempts)"
  },
  "UNKNOWN": {
   "owner": "INTEGRATION",
   "retryable": false,
   "budget": null,
   "rule": "§22: a non-AISEF error flattens to UNKNOWN; §15: cause undetermined -> INTEGRATION, never DEVELOPER"
  }
 },
