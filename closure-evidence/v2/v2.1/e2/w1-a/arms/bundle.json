   "requirement": "R-2.1",
   "section": "§2",
   "subject": "treesum.snapshot:build"
  },
  "C-BUILD-3": {
   "clause": "2.1",
   "clause_text": "treesum.snapshot.build(root) returns a dict mapping every file under the directory root — recursively, at any depth — to its file_sha256; a key is the file's path relative to root, with / as the separator.",
   "requirement": "R-2.1",
   "section": "§2",
   "subject": "treesum.snapshot:build"
  },
