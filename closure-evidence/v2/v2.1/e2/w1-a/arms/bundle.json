   "clause": "5.4",
   "clause_text": "python -m treesum verify DIR FILE reads the snapshot in FILE, builds the current snapshot of DIR and prints one line per difference, in ascending order of path; it exits 0 when there is no difference (printing nothing) and 1 when there is at least one.",
   "requirement": "R-5.4",
