   "requirement": "R-2.3",
   "section": "§2",
   "subject": "treesum.snapshot:build"
  },
  "C-CLI-BUILD": {
   "clause": "5.2",
   "clause_text": "python -m treesum build DIR writes dumps(build(DIR)) to standard output and exits 0.",
   "requirement": "R-5.2",
   "section": "§5",
   "subject": "treesum:__main__ build"
  },
