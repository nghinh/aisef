 "product_roots": [
  "tests",
  "treesum"
 ],
 "requirements": [
  {
   "id": "R-0",
   "requirement_hash": "6121cfda26cff307bb6d10374fb5d2d282dbb862891bd9c9cdad792573172708",
   "source": "docs/requirements.md#preamble",
   "text": "treesum uses the Python standard library only: no third-party dependency exists and none may be added."
  },
  {
   "id": "R-1.1",
   "requirement_hash": "d95589668652d686c092d70c14621b683fc19701d175c483fbc92210fb2f06b2",
   "source": "docs/requirements.md#1.1",
   "text": "treesum.digest.file_sha256(path) returns the SHA-256 of the file's bytes as 64 lowercase hexadecimal characters."
  },
  {
   "id": "R-1.2",
   "requirement_hash": "1d2c888cc040c73cfe36fcd592800bf5b1c7c1b4ebf3a4d00b3cf11605558925",
   "source": "docs/requirements.md#1.2",
   "text": "path may be a str or a pathlib.Path. A path that does not exist raises FileNotFoundError."
  },
  {
   "id": "R-2.1",
   "requirement_hash": "53093bf744af6d7ffd67d36e671d333a0ad0782e14440cf306c8fda633420fd7",
   "source": "docs/requirements.md#2.1",
   "text": "treesum.snapshot.build(root) returns a dict mapping every file under root, recursively, to its file_sha256, keyed by the path relative to root with / as separator."
  },
  {
   "id": "R-2.3",
   "requirement_hash": "778b89df070a675b98d8df3fd875e3ab16073870ef073c9c4013072f6473235d",
   "source": "docs/requirements.md#2.3",
   "text": "A root that does not exist, or that exists and is not a directory, raises NotADirectoryError."
  },
  {
   "id": "R-3.1",
   "requirement_hash": "548c2cee47353af480232e290d4ed27fbe78404eae839fcf74ac0da101675142",
   "source": "docs/requirements.md#3.1",
   "text": "treesum.snapshot.dumps(snapshot) returns one line per entry, `<sha256>  <path>`, each ended by a newline, in ascending order of path."
  },
  {
   "id": "R-3.2",
   "requirement_hash": "ad190dd63355c181793fc213aaf4b8e2d921e3cbf21c54d8ec77b644269a8d80",
   "source": "docs/requirements.md#3.2",
   "text": "treesum.snapshot.loads(text) parses the snapshot text format back into a dict. Empty lines and lines holding only whitespace are ignored; a final line without a newline is read like any other. A line that is not <64 lowercase hex characters>, two spaces, <a non-empty path> raises ValueError."
  },
  {
   "id": "R-3.3",
   "requirement_hash": "4cffbb65eb557e87d2c467b897ce66d6b258dc65f96364f75d09eb67383fa2a9",
   "source": "docs/requirements.md#3.3",
   "text": "loads(dumps(s)) == s for every snapshot s."
  },
  {
   "id": "R-4.1",
   "requirement_hash": "837055c4d3605e5e0bdfcabc86fd3815f0e96f43eb5958d5614779087810abab",
   "source": "docs/requirements.md#4.1",
   "text": "treesum.snapshot.compare(old, new) returns a dict with exactly the keys added, removed and changed, each a list of paths in ascending order."
  },
  {
   "id": "R-5.2",
   "requirement_hash": "be1186bca4106cde4f91b1c0a192f19702f366b5b3ce1841ef61f6933032928a",
   "source": "docs/requirements.md#5.2",
   "text": "python -m treesum build DIR writes dumps(build(DIR)) to standard output and exits 0."
  },
  {
   "id": "R-5.3",
   "requirement_hash": "9e8d8e7f04bfd358587305f65e9b3350b33eba20afdf82a54ecb4fe5c05ba830",
   "source": "docs/requirements.md#5.3",
   "text": "python -m treesum build DIR -o FILE writes the same text to FILE instead — creating it, or replacing its previous content — with nothing on standard output, and exits 0. When FILE lies inside DIR, FILE is not an entry of the snapshot."
  },
  {
   "id": "R-5.4",
   "requirement_hash": "3e2422ee8af90bff21fdbb69b283c9ecaa9d4b39558976548be7fa7b2e9bf99b",
   "source": "docs/requirements.md#5.4",
   "text": "python -m treesum verify DIR FILE prints one line per difference and exits 0 when there is no difference, 1 when there is at least one."
  },
  {
   "id": "R-5.5",
   "requirement_hash": "856a11b955a66507efc75745f3bbbb8f961fe1e67b1f59ae4c640bda1999a6c7",
   "source": "docs/requirements.md#5.5",
   "text": "Any other use exits 2 with a message on standard error and nothing on standard output: an unknown or missing subcommand, missing or extra arguments, a DIR that is not a directory, a FILE that cannot be read or that does not parse."
  }
 ],
