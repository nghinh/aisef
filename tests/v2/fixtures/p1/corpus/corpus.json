   "stimulus": {},
   "observable": {
    "condition": "exists"
   },
   "polarity": "MUST_NOT_HOLD",
   "subject_absence": "ABSENCE_IS_DECIDABLE",
   "rationale": "NEG-2: a forbidden module MUST NOT exist; its absence is the whole point",
   "contract_hash": "470f3ddc0af12ec01cfb45cbd6b80a96783e2f9e1783d12b6a56083fb780b7cd"
