 ],
 "contracts": [
  {
   "id": "BC-QUIET-STDOUT",
   "requirement_ids": [
    "REQ-QUIET"
   ],
   "subject": {
    "kind": "cli_invocation",
    "locator": "app.cli:main"
   },
   "stimulus": {
    "argv": [
     "--quiet",
     "status"
    ]
   },
   "observable": {
    "condition": "non_empty",
    "stream": "stdout"
   },
   "polarity": "MUST_NOT_HOLD",
   "subject_absence": "REQUIRES_SUBJECT",
   "rationale": "NEG-1 / NEG-3: the CLI MUST NOT write to stdout in quiet mode; undecidable without the CLI",
   "contract_hash": "f46bca9e45c6de52468de11b776157d83e98f48a3b053671211db34f0c2c1c23"
  },
  {
