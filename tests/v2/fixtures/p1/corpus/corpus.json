 "requirements": [
  {
   "id": "REQ-QUIET",
   "text": "In quiet mode the CLI prints nothing on stdout.",
   "source": "docs/requirements.md#quiet",
   "requirement_hash": "d50d27874a6010a47316fa44047ecf4faae4e237d60f8facb9f4fa208a6d419c"
  },
  {
   "id": "REQ-NO-TELEMETRY",
