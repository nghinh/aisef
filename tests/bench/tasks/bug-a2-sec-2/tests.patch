+
+
+class TestThongBaoNgoaiPhamViNoiTenTepTruoc(unittest.TestCase):
+    """Danh sách phạm vi lên tới 27 mục sau khi harness thêm thư mục kiểm
+    định, mà mọi nơi đọc thông báo này đều gấp về **một dòng** — nên thứ duy
+    nhất người đọc cần (tệp nào) luôn là phần bị cắt (đo `todo-e2e`
+    2026-09-09)."""
+
+    def test_ten_tep_pham_loi_dung_truoc_danh_sach_pham_vi(self):
+        from aisef.harness.guardrails import check_diff_scope
+
+        scope = [f"duong-dan-rat-dai-so-{i}" for i in range(27)]
+        v = check_diff_scope(["ke-hoach/khong-thuoc-pham-vi.md"], scope)
+        self.assertFalse(v.allowed)
+        self.assertLess(v.reason.index("khong-thuoc-pham-vi.md"), v.reason.index("Scope:"),
+                        v.reason)
+        self.assertIn("(+15 more)", v.reason)
