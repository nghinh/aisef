+def project_root_from(env: dict[str, str] | None, fallback: str) -> str:
+    """Gốc dự án cho guard: env của harness thắng, `--project` biên dịch là dự phòng."""
+    goc = (env if env is not None else os.environ).get(ENV_PROJECT, "").strip()
