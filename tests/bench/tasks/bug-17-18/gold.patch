+    trạng thái hiện tại.
+    """
+    if not maps:
+        return "✗"
+    latest: dict[str, bool] = {}
+    for m in maps:
+        latest[m.name] = bool(m.ok)
+    return "✅" if all(latest.values()) else "✗"
