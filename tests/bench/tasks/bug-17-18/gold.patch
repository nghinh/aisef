+def mockup_cell(maps) -> str:
+    """Ô "Map mockup" của một story: **kết quả mới nhất của từng màn hình**.
+
+    Trước 2026-09-05 ô này đòi *mọi* lần đối chiếu từng đạt — story qua cổng
