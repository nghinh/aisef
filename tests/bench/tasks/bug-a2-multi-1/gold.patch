+_PW = re.compile(
+    r"^\s*([✓✘×✕⊘-])\s+\d+\s+"
+    r"(?:\[([^\]]+)\]\s+›\s+)?"
+    r"\S+?:\d+:\d+\s+›\s+"
+    r"(.+?)(?:\s+\(\d+(?:\.\d+)?m?s\))?\s*$"
+)
 
 
