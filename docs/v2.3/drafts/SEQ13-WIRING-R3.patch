+#: RA-GP-1: what the V22_REPLAYED skip stands on, pinned by the sha256 of each file's LF bytes — the round-v2.3
+#: counterparts, the replay, the digest tool, and the (empty) package file that lets `discover` find them. The skip
+#: holds only while every pinned file is exactly as pinned; a deleted or edited one un-skips all 11, which then run
+#: under AISEF_SEALING=1 as they did before seq 13. Changing a pinned file therefore needs an edit of this file, which
+#: is wiring other than the one ledger seq 13 names.
+V23_PINNED = {
+    "tests/v23/__init__.py": "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855",
+    "tests/v23/test_v23_rounds.py": "79433cacb80ba7abf9234dfaaac39c996486ea745b2a1849f3a619aa2aa56620",
+    "validation/v23/ledger_digest.py": "660624c01b47811b8b9d2f41f371d4b721bb8b7c802eaa87b656c05f99ee3df9",
+    "validation/v23/replay_v22.py": "3414936eac1e1b70ef626c12b1348f8c2d2c90041980bdb743e5a6ff8fcf9a46",
+}
+
+
+def _lf_sha256(rel: str) -> str | None:
+    try:
+        return hashlib.sha256((ROOT / rel).read_bytes().replace(b"\r\n", b"\n")).hexdigest()
+    except OSError:
+        return None
+
+
+V23_PINS_HOLD = all(_lf_sha256(rel) == want for rel, want in V23_PINNED.items())
+
+
+def sealing(obj):
+    """The one gate. Its id is the defining file's repo-relative path + `__qualname__` (never `__module__`: `discover
+    -s tests` names modules `v2.test_x`). A V22_REPLAYED test is skipped naming the replay, but only while
+    V23_PINS_HOLD; every other gated test, and a V22_REPLAYED one when a pin breaks, is a visible skip without
+    AISEF_SEALING=1 and runs with it."""
+    try:
+        rid = f"{pathlib.Path(inspect.getfile(obj)).resolve().relative_to(ROOT).as_posix()}::{obj.__qualname__}"
+    except (TypeError, ValueError):
+        rid = None
+    if rid in V22_REPLAYED and V23_PINS_HOLD:
+        return unittest.skip("round v2.2 history: replayed at v2.2.0 (da3ea33f) by validation/v23/replay_v22.py; "
+                             "round v2.3 = tests/v23/test_v23_rounds.py::RoundV23")(obj)
+    return _sealing(obj)
+
