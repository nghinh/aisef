__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.DS_Store
.env
.env.*
.mypy_cache/
.ruff_cache/
*.egg-info/
dist/
build/

# repo tham chiếu clone ngoài — không commit **mã**, nhưng commit bản ghi ghim:
# `PINS.md` là xuất xứ của mọi kết luận đọc từ các kho ấy, và `clone.sh` là cách
# dựng lại đúng bản đã đọc. Để cả hai sống trên một máy là cách mất chúng —
# cây bằng chứng của e9 đã biến mất đúng kiểu đó.
references/*
!references/PINS.md
!references/clone.sh

# spike: phụ thuộc cài tạm, không commit
spike/**/node_modules/
spike/**/package-lock.json

# tạo tác của lượt hợp quy client (giữ để tra, không commit)
.conformance/
.dogfood/
# bench (ADR-005 V8): task story sinh từ e9, bản chép, kết quả — chỉ task lỗi kho ở tests/bench/tasks/ mới commit
.bench/
# paired A/B/C memory harness (ADR-008): per-arm kết quả là tạo tác, không commit
framework/bench/memory_compare/results/

# worktree của subagent (Agent tool)
.claude/worktrees/

# OpenCode / Serena plugin
.serena/

# uv lock — not used for this project
uv.lock
.bench-c1b/
# đợt tuyển cặp model↔CLI (G5.3): cây làm việc + sổ phiên. **Không** đặt tên
# `.bench-*` có chủ ý — phiên tuyển không phải dữ liệu cohort, và mọi thứ quét
# `.bench*/results.jsonl` (probe G5.2, `_analyze.cut_sessions`) phải không thấy
# chúng. Bản sổ được commit là `closure-evidence/bench-pair-qualification.jsonl`.
.aisef-qual/
# Mỗi cohort ghi vào thư mục riêng (`AISEF_BENCH_DIR=.bench-c2`, …) để không xoá
# cây làm việc mà báo cáo của cohort trước đang trích dẫn làm bằng chứng.
.bench-*/

# cổng đóng dự án: báo cáo là **đầu ra**, dựng lại được bằng `aisef closure`.
# Bản chấm từ một worktree ghi hàng loạt UNRUNNABLE không so sánh được — đừng
# để nó lọt vào kho như thể là bản ghi. Chữ ký và waiver
# (`closure-evidence/closure-state.json`) thì **commit**: đó là quyết định.
closure-evidence/closure-report.json
docs/CLOSURE-REPORT.md
